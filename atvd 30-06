        <select name="estado" id="state">

            <option>Paraná</option>
            <option>São Paulo</option>
            <option>Rio de Janeiro</option>
            <option>Acre (habitat de nossa querida doll)</option>
            
        </select>

        <!--input radio-->
        <label for="historico">selecione sua gênera:</label>
        <input type="radio" name="historico">
        masculina

        <input type="radio" name="historico">
        feminina

        <input type="radio" name="historico">
        neutro
        
        <input type="radio" name="historico">
        todes

        <!--input checkbox-->
        <label>
            <input type="checkbox" id="options">
            aceito vender minha alma

            <input type="checkbox" id="options">
            enviar 100reais a cada compra para o orçamento de "quando a luz se apaga"
        </label>

        <!--text area-->
        <label>
            obs.:
        </label>

        <textarea rows="4"></textarea>

        <!--button-->
        <button type="submit">
            envie agora!
        </button>
    
    </form>

