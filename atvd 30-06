        <label for="nome">nome:</label>
        <input type="text" name="nome do cliente" id="nome" placeholder="Rodrigo Apresentador" required>

        <!--input email-->
        <label for="email">email:</label>
        <input type="email" name="email" id="email" placeholder="exemplo@endereço.com" required>

        <!--input senha-->
